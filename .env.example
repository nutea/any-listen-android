# Copy to .env (never commit). Used only by tools/probe.

ANYLISTEN_BASE_URL=https://example.invalid
# Optional reverse-proxy prefix already included in BASE_URL, e.g. https://host/music
ANYLISTEN_PASSWORD=
# Optional. Independent playlist id for write tests. Leave empty to skip writes.
ANYLISTEN_TEST_PLAYLIST_ID=
# Optional. Seconds. Default 20.
ANYLISTEN_TIMEOUT_SEC=20
