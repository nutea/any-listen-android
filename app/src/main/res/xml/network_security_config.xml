<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cover hosts may only serve HTTP. Login, API, and audio still reject non-localhost HTTP. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
