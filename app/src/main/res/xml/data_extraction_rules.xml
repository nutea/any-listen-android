<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="session" />
        <exclude domain="sharedpref" path="session_fallback" />
        <exclude domain="file" path="downloads/" />
        <exclude domain="file" path="downloads" />
        <exclude domain="database" path="any-listen.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session" />
        <exclude domain="sharedpref" path="session_fallback" />
        <exclude domain="file" path="downloads/" />
    </device-transfer>
</data-extraction-rules>
